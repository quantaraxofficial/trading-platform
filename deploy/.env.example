# Copy to deploy/.env on the VM and fill in. Never commit a real .env.

# --- ClickHouse (container) ----------------------------------------------
CLICKHOUSE_PASSWORD=change-me-to-something-long
CLICKHOUSE_DATABASE=ticks
CLICKHOUSE_USER=default

# --- Symbols to collect (comma-separated, keep <= 10 on the free VM) ------
# Each symbol at 30s ≈ 0.5 MB/day. 10 symbols ≈ 15 GB/year, well under the
# 200 GB free block-storage cap.
PIPELINE_SYMBOLS=XAUUSD

# --- Resampling. 30 = the target granularity. 1 = keep raw ticks (do NOT
# --- set this on the free VM — it will exhaust the 200 GB volume fast.)
PIPELINE_RESAMPLE_SECONDS=30

# --- MT5 headless credentials (Vantage). The mt5-terminal container keeps a
# --- logged-in terminal; the collector attaches to it.
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=Vantage-Demo

# --- Collector tuning
PIPELINE_MAX_PENDING_BARS=5000
PIPELINE_DATA_TTL_DAYS=730
