# Django backend (REST + collab WebSockets through daphne)
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/
RUN useradd --create-home --uid 10001 app && mkdir -p /data/static /data/media /data/private && chown -R app /data /app
USER app

EXPOSE 8000
# Migrations and the admin's static files on every start, then the server
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py collectstatic --noinput && daphne -b 0.0.0.0 -p 8000 --proxy-headers quantarax_backend.asgi:application"]
