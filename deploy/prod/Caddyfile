# HTTPS (Let's Encrypt, automatic) for SITE_HOST. The backend gets its API, admin, WebSockets and
# files; everything else is the Next.js app (including its own /api/* data routes).
{$SITE_HOST} {
	encode zstd gzip

	handle /static/* {
		root * /srv
		file_server
	}
	handle /media/* {
		root * /srv
		file_server
	}
	@backend path /api/users/* /ws/* /admin /admin/*
	handle @backend {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}

	header {
		-Server
	}
}
