{
  "name": "tradepilot-desktop",
  "productName": "TradePilot",
  "version": "1.0.0",
  "description": "TradePilot on this PC: the merge branch's site and backend, started by the app (src/config.json)",
  "main": "src/main.js",
  "author": "TradePilot",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.cjs",
    "dist": "electron-builder --win dir --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.tradepilot.desktop.local",
    "productName": "TradePilot",
    "copyright": "\u00a9 2026 TradePilot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "TradePilot-Setup-${version}.${ext}"
    }
  }
}
