<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch screen: TradePilot's mark on the app's dark background -->
    <style name="Theme.TradePilot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F0F10</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TradePilot</item>
    </style>
    <style name="Theme.TradePilot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
