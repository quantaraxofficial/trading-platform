rules_version = '2';

// Each signed-in user reads and writes only their own document in the collections the app uses
// (their alerts, chart settings and paper-trading accounts). Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collection in ['userAlerts', 'userSettings', 'userPaperTrading'];
    }
  }
}
